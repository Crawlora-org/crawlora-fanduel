  "keywords": [
    "crawlora",
    "api-client",
    "sdk",
    "web-scraping",
    "scraping-api",
    "fanduel",
    "fanduel-api",
    "fanduel-scraper",
    "fanduel-data",
    "fanduel-public-racing",
    "fanduel-casino-catalogue",
    "fanduel-research-data"
  ],
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
